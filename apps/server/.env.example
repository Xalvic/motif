# Copy this file to apps/server/.env (git ignores it) and put your own codes in.
# On the host, set the same vars in its env settings.

# Invite codes: name:code pairs, comma-separated. Names use a-z, 0-9 and -.
# Codes need 16+ characters. Make one with: npm run new-code -w @motif/server -- <name>
# To revoke a person, remove their pair and restart the server.
INVITE_CODES=owner:replace-me-with-a-real-code

# Port of the API server. The Vite dev server proxies /api to it. Not PORT: dev tools
# set PORT for the web server, and the API would take that port too.
API_PORT=8787

# fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info

# 1 = readable, coloured log lines (dev). Leave it out on the host: logs are then JSON lines.
LOG_PRETTY=1
